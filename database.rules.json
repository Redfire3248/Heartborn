{
  "rules": {
    "errors": {
      ".read": "auth != null && root.child('admins').child(auth.uid).val() === true",
      ".write": "auth != null && root.child('admins').child(auth.uid).val() === true",
      ".indexOn": [
        "ts"
      ],
      "$id": {
        ".write": "auth != null && !data.exists() && newData.child('uid').val() === auth.uid",
        ".validate": "newData.hasChildren(['uid', 'message', 'ts']) && newData.child('message').isString() && newData.child('message').val().length <= 300"
      }
    },
    "reports": {
      ".read": "auth != null && root.child('admins').child(auth.uid).val() === true",
      ".write": "auth != null && root.child('admins').child(auth.uid).val() === true",
      "$id": {
        ".write": "auth != null && !data.exists() && newData.child('from').val() === auth.uid",
        ".validate": "newData.hasChildren(['from', 'target', 'reason', 'ts']) && newData.child('reason').isString() && newData.child('reason').val().length <= 300"
      }
    },
    "announcements": {
      ".read": "auth != null",
      ".write": "auth != null && root.child('admins').child(auth.uid).val() === true"
    },
    "globalEvent": {
      ".read": "auth != null",
      ".write": "auth != null && root.child('admins').child(auth.uid).val() === true"
    },
    "adminCommands": {
      "$uid": {
        ".read": "auth != null && auth.uid === $uid",
        "$cmd": {
          ".write": "auth != null && ((root.child('admins').child(auth.uid).val() === true) || (auth.uid === $uid && !newData.exists()))"
        }
      }
    },
    "w": {
      "$world": {
        "presence": {
          ".read": "($world === 'realm' || root.child('worldMembers').child($world).child(auth.uid).exists()) && (auth != null)",
          "$uid": {
            ".write": "($world === 'realm' || root.child('worldMembers').child($world).child(auth.uid).exists()) && (auth != null && auth.uid === $uid)"
          }
        },
        "live": {
          ".read": "($world === 'realm' || root.child('worldMembers').child($world).child(auth.uid).exists()) && (auth != null)",
          "$uid": {
            ".write": "($world === 'realm' || root.child('worldMembers').child($world).child(auth.uid).exists()) && (auth != null) && auth.uid === $uid"
          }
        },
        "edits": {
          ".read": "($world === 'realm' || root.child('worldMembers').child($world).child(auth.uid).exists()) && (auth != null)",
          ".indexOn": [
            "ts"
          ],
          ".write": "($world === 'realm' || root.child('worldMembers').child($world).child(auth.uid).exists()) && (auth != null)",
          "$id": {
            ".validate": "!newData.exists() || (newData.child('uid').val() === auth.uid && newData.child('t').isString())"
          }
        },
        "mobHost": {
          ".read": "($world === 'realm' || root.child('worldMembers').child($world).child(auth.uid).exists()) && (auth != null)",
          ".write": "($world === 'realm' || root.child('worldMembers').child($world).child(auth.uid).exists()) && (auth != null)"
        },
        "mobs": {
          ".read": "($world === 'realm' || root.child('worldMembers').child($world).child(auth.uid).exists()) && (auth != null)",
          ".write": "($world === 'realm' || root.child('worldMembers').child($world).child(auth.uid).exists()) && (auth != null) && root.child('w').child($world).child('mobHost').child('uid').val() === auth.uid"
        },
        "mobHits": {
          "$host": {
            ".read": "($world === 'realm' || root.child('worldMembers').child($world).child(auth.uid).exists()) && (auth != null) && auth.uid === $host",
            ".write": "($world === 'realm' || root.child('worldMembers').child($world).child(auth.uid).exists()) && (auth != null)"
          }
        },
        "mobKills": {
          ".read": "($world === 'realm' || root.child('worldMembers').child($world).child(auth.uid).exists()) && (auth != null)",
          ".indexOn": [
            "ts"
          ],
          ".write": "($world === 'realm' || root.child('worldMembers').child($world).child(auth.uid).exists()) && (auth != null)"
        },
        "cmds": {
          "$to": {
            ".read": "($world === 'realm' || root.child('worldMembers').child($world).child(auth.uid).exists()) && (auth != null) && auth.uid === $to",
            ".write": "($world === 'realm' || root.child('worldMembers').child($world).child(auth.uid).exists()) && (auth != null) && (auth.uid === $to || root.child('worlds').child($world).child('owner').val() === auth.uid || root.child('admins').child(auth.uid).val() === true)"
          }
        },
        "chat": {
          ".read": "($world === 'realm' || root.child('worldMembers').child($world).child(auth.uid).exists()) && (auth != null)",
          ".indexOn": [
            "ts"
          ],
          ".write": "($world === 'realm' || root.child('worldMembers').child($world).child(auth.uid).exists()) && (auth != null && root.child('admins').child(auth.uid).val() === true)",
          "$msg": {
            ".write": "($world === 'realm' || root.child('worldMembers').child($world).child(auth.uid).exists()) && (auth != null && ((!data.exists() && newData.child('uid').val() === auth.uid) || (root.child('admins').child(auth.uid).val() === true)))",
            ".validate": "!newData.exists() || (newData.hasChildren(['uid', 'name', 'text', 'ts']) && newData.child('text').isString() && newData.child('text').val().length <= 200)"
          }
        },
        "offers": {
          "$to": {
            ".read": "($world === 'realm' || root.child('worldMembers').child($world).child(auth.uid).exists()) && (auth != null && auth.uid === $to)",
            "$id": {
              ".write": "($world === 'realm' || root.child('worldMembers').child($world).child(auth.uid).exists()) && (auth != null && (auth.uid === $to || (!data.exists() && newData.child('from').val() === auth.uid)))"
            }
          }
        },
        "offersSent": {
          "$from": {
            ".read": "($world === 'realm' || root.child('worldMembers').child($world).child(auth.uid).exists()) && (auth != null && auth.uid === $from)",
            "$id": {
              ".write": "($world === 'realm' || root.child('worldMembers').child($world).child(auth.uid).exists()) && (auth != null && (auth.uid === $from || (data.exists() && data.child('to').val() === auth.uid)))"
            }
          }
        },
        "attacks": {
          "$def": {
            ".read": "($world === 'realm' || root.child('worldMembers').child($world).child(auth.uid).exists()) && (auth != null && auth.uid === $def)",
            "$id": {
              ".read": "($world === 'realm' || root.child('worldMembers').child($world).child(auth.uid).exists()) && (auth != null && (auth.uid === $def || data.child('from').val() === auth.uid))",
              ".write": "($world === 'realm' || root.child('worldMembers').child($world).child(auth.uid).exists()) && (auth != null && (auth.uid === $def || (!data.exists() && newData.child('from').val() === auth.uid) || (data.exists() && data.child('from').val() === auth.uid)))"
            }
          }
        },
        "attacksSent": {
          "$from": {
            ".read": "($world === 'realm' || root.child('worldMembers').child($world).child(auth.uid).exists()) && (auth != null && auth.uid === $from)",
            "$id": {
              ".write": "($world === 'realm' || root.child('worldMembers').child($world).child(auth.uid).exists()) && (auth != null && auth.uid === $from)"
            }
          }
        },
        "sea": {
          ".read": "($world === 'realm' || root.child('worldMembers').child($world).child(auth.uid).exists()) && auth != null",
          "$uid": {
            ".write": "($world === 'realm' || root.child('worldMembers').child($world).child(auth.uid).exists()) && auth != null && auth.uid === $uid"
          }
        },
        "seaShots": {
          ".read": "($world === 'realm' || root.child('worldMembers').child($world).child(auth.uid).exists()) && auth != null",
          "$id": {
            ".write": "($world === 'realm' || root.child('worldMembers').child($world).child(auth.uid).exists()) && auth != null && ((!data.exists() && newData.child('from').val() === auth.uid) || (data.exists() && !newData.exists() && data.child('from').val() === auth.uid))"
          }
        },
        "seaSunk": {
          ".read": "($world === 'realm' || root.child('worldMembers').child($world).child(auth.uid).exists()) && auth != null",
          "$id": {
            ".write": "($world === 'realm' || root.child('worldMembers').child($world).child(auth.uid).exists()) && auth != null && ((!data.exists() && newData.child('victim').val() === auth.uid) || (data.exists() && !newData.exists() && (data.child('by').val() === auth.uid || data.child('victim').val() === auth.uid)))"
          }
        },
        "visits": {
          "$host": {
            ".read": "($world === 'realm' || root.child('worldMembers').child($world).child(auth.uid).exists()) && (auth != null && auth.uid === $host)",
            "$guest": {
              ".read": "auth != null && (auth.uid === $guest || auth.uid === $host)",
              ".write": "($world === 'realm' || root.child('worldMembers').child($world).child(auth.uid).exists()) && auth != null && ((auth.uid === $guest && (!newData.exists() || newData.child('status').val() === 'ask')) || (auth.uid === $host && (!newData.exists() || data.exists())))",
              "status": {
                ".write": "auth != null && auth.uid === $host && data.exists() && (newData.val() === 'yes' || newData.val() === 'no')"
              },
              ".validate": "!newData.exists() || (newData.hasChildren(['status', 'ts']) && (newData.child('name').val() == null || (newData.child('name').isString() && newData.child('name').val().length <= 40)))"
            }
          }
        },
        "alliances": {
          ".read": "($world === 'realm' || root.child('worldMembers').child($world).child(auth.uid).exists()) && (auth != null)",
          "$uid": {
            "$other": {
              ".write": "($world === 'realm' || root.child('worldMembers').child($world).child(auth.uid).exists()) && (auth != null && auth.uid === $uid)"
            }
          }
        },
        "missions": {
          "$def": {
            ".read": "($world === 'realm' || root.child('worldMembers').child($world).child(auth.uid).exists()) && (auth != null && auth.uid === $def)",
            "$id": {
              ".read": "($world === 'realm' || root.child('worldMembers').child($world).child(auth.uid).exists()) && (auth != null && (auth.uid === $def || data.child('from').val() === auth.uid))",
              ".write": "($world === 'realm' || root.child('worldMembers').child($world).child(auth.uid).exists()) && (auth != null && (auth.uid === $def || (!data.exists() && newData.child('from').val() === auth.uid) || (data.exists() && data.child('from').val() === auth.uid)))"
            }
          }
        },
        "strangers": {
          "$host": {
            ".read": "($world === 'realm' || root.child('worldMembers').child($world).child(auth.uid).exists()) && auth != null",
            "$id": {
              ".write": "($world === 'realm' || root.child('worldMembers').child($world).child(auth.uid).exists()) && auth != null && ((!data.exists() && newData.child('from').val() === auth.uid) || (data.exists() && data.child('from').val() === auth.uid) || (auth.uid === $host && !newData.exists()))",
              ".validate": "!newData.exists() || (newData.hasChildren(['from', 'x', 'y', 'ts']) && newData.child('x').isNumber() && newData.child('y').isNumber() && (newData.child('name').val() == null || (newData.child('name').isString() && newData.child('name').val().length <= 40)))"
            }
          }
        },
        "pvpHits": {
          "$uid": {
            ".read": "($world === 'realm' || root.child('worldMembers').child($world).child(auth.uid).exists()) && auth != null && auth.uid === $uid",
            "$id": {
              ".write": "($world === 'realm' || root.child('worldMembers').child($world).child(auth.uid).exists()) && auth != null && ((!data.exists() && newData.child('from').val() === auth.uid) || (auth.uid === $uid && !newData.exists()))",
              ".validate": "!newData.exists() || (newData.hasChildren(['from', 'dmg', 'x', 'y', 'ts']) && newData.child('dmg').isNumber() && newData.child('dmg').val() >= 0 && newData.child('dmg').val() <= 200)"
            }
          }
        },
        "missionsSent": {
          "$from": {
            ".read": "($world === 'realm' || root.child('worldMembers').child($world).child(auth.uid).exists()) && (auth != null && auth.uid === $from)",
            "$id": {
              ".write": "($world === 'realm' || root.child('worldMembers').child($world).child(auth.uid).exists()) && (auth != null && auth.uid === $from)"
            }
          }
        }
      }
    },
    "profiles": {
      ".read": "auth != null",
      "$uid": {
        ".write": "auth != null && auth.uid === $uid"
      }
    },
    "friends": {
      "$uid": {
        ".read": "auth != null && auth.uid === $uid",
        "$other": {
          ".write": "auth != null && (auth.uid === $uid || ($other === auth.uid && (!newData.exists() || (newData.val() === 'in' && !data.exists()) || (newData.val() === 'friend' && data.val() === 'out'))))",
          ".validate": "!newData.exists() || newData.val() === 'in' || newData.val() === 'out' || newData.val() === 'friend'"
        }
      }
    },
    "worlds": {
      ".read": "auth != null",
      "$wid": {
        ".write": "auth != null && ((!data.exists() && newData.child('owner').val() === auth.uid) || data.child('owner').val() === auth.uid || (auth != null && root.child('admins').child(auth.uid).val() === true))"
      }
    },
    "worldMembers": {
      "$wid": {
        ".read": "auth != null && root.child('worldMembers').child($wid).child(auth.uid).exists()",
        "$uid": {
          ".write": "auth != null && (auth.uid === $uid || root.child('worlds').child($wid).child('owner').val() === auth.uid)"
        }
      }
    },
    "userWorlds": {
      "$uid": {
        ".read": "auth != null && auth.uid === $uid",
        ".write": "auth != null && auth.uid === $uid"
      }
    },
    "worldInvites": {
      "$uid": {
        ".read": "auth != null && auth.uid === $uid",
        "$wid": {
          ".write": "auth != null && (auth.uid === $uid || root.child('worldMembers').child($wid).child(auth.uid).exists())"
        }
      }
    },
    "worldCodes": {
      "$code": {
        ".read": "auth != null",
        ".write": "auth != null && ((!data.exists() && root.child('worlds').child(newData.val()).child('owner').val() === auth.uid) || (!newData.exists() && root.child('worlds').child(data.val()).child('owner').val() === auth.uid))"
      }
    },
    "lobby": {
      "$wid": {
        ".read": "auth != null && root.child('worldMembers').child($wid).child(auth.uid).exists()",
        "$uid": {
          ".write": "auth != null && auth.uid === $uid && root.child('worldMembers').child($wid).child(auth.uid).exists()"
        }
      }
    }
  }
}
